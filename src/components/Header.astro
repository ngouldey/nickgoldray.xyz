---
const { pathname } = Astro.url;

const links = [
	{ href: "/", label: "Home" },
	{ href: "/gallery/", label: "Gallery" },
	{ href: "mailto:pokerpoot@gmail.com", label: "Contact" },
];
---

<header class="site-header">
	<div class="container">
		<a class="wordmark" href="/">Nick Goldray</a>
		<nav aria-label="Primary">
			<ul>
				{
					links.map((link) => (
						<li>
							<a href={link.href} aria-current={pathname === link.href ? "page" : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		text-align: center;
		margin-bottom: var(--space-5);
	}

	.wordmark {
		display: block;
		font-size: 50px;
		margin: var(--space-5) auto var(--space-4);
		max-width: 754px;
	}

	nav ul {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 25px;
	}

	nav a {
		display: block;
		padding: 2px 25px;
	}

	nav a[aria-current="page"] {
		text-decoration: underline;
		text-underline-offset: 6px;
	}

	@media screen and (max-width: 767px) {
		.wordmark {
			font-size: 34px;
			margin: var(--space-4) auto var(--space-3);
		}

		nav ul {
			font-size: 18px;
			justify-content: space-evenly;
		}

		nav a {
			padding: 2px 10px;
		}
	}
</style>
