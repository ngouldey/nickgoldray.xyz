---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
	photo: CollectionEntry<"photos">;
}

const { photo } = Astro.props;
const { title, image } = photo.data;
---

<div class="card">
	<button type="button" class="frame" data-float-trigger aria-label={`Expand ${title}`}>
		<Image class="thumb" src={image} alt={title} width={1200} transition:name={`photo-${photo.id}`} />
	</button>
	<a class="caption" href={`/photos/${photo.id}/`}>{title}</a>
</div>

<style>
	.card {
		display: inline-block;
		width: 33.33%;
		padding: 0 10px 80px;
		text-align: center;
		vertical-align: top;
	}

	.frame {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		aspect-ratio: 1 / 1;
		padding: 30px;
		background: none;
		border: none;
		cursor: pointer;
	}

	.thumb {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		transition:
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
			filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.frame:hover .thumb,
	.frame:focus-visible .thumb {
		transform: scale(1.06);
		filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.18));
	}

	.caption {
		display: block;
		font-size: 20px;
		line-height: 30px;
		padding: 0 20px;
	}

	.caption:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	@media screen and (max-width: 767px) {
		.card {
			width: 50%;
			padding: 0 10px 50px;
		}

		.frame {
			padding: 15px;
		}

		.caption {
			font-size: 18px;
			line-height: 26px;
			padding: 0 8px;
		}
	}
</style>
