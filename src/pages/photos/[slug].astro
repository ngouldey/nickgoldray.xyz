---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const photos = await getCollection("photos");
	return photos.map((photo) => ({
		params: { slug: photo.id },
		props: { photo },
	}));
}

const { photo } = Astro.props;
const { title, image, date, location, tags } = photo.data;
const { Content } = await render(photo);

const formattedDate = date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={`${title} — Nick Goldray`}>
	<article class="container">
		<a class="back" href="/gallery/">← Back to gallery</a>
		<Image class="full" src={image} alt={title} width={1600} transition:name={`photo-${photo.id}`} />
		<div class="meta">
			<h1>{title}</h1>
			<dl>
				<div>
					<dt>Date</dt>
					<dd>{formattedDate}</dd>
				</div>
				{
					location && (
						<div>
							<dt>Location</dt>
							<dd>{location}</dd>
						</div>
					)
				}
				{
					tags.length > 0 && (
						<div>
							<dt>Tags</dt>
							<dd>{tags.join(", ")}</dd>
						</div>
					)
				}
			</dl>
			<div class="caption">
				<Content />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	article {
		padding-block: var(--space-3) var(--space-5);
	}

	.back {
		display: inline-block;
		margin-bottom: var(--space-3);
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.back:hover {
		color: var(--text);
	}

	.full {
		width: 100%;
		height: auto;
		background: var(--bg-elevated);
	}

	.meta {
		margin-top: var(--space-3);
		max-width: 640px;
	}

	.meta h1 {
		margin-bottom: var(--space-2);
	}

	dl {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin: 0 0 var(--space-3);
	}

	dt {
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.15rem;
	}

	dd {
		margin: 0;
		font-size: 0.9rem;
	}

	.caption :global(p) {
		font-size: 0.95rem;
	}
</style>
