---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const photos = await getCollection("photos");
	return photos.map((photo) => ({
		params: { slug: photo.id },
		props: { photo },
	}));
}

const { photo } = Astro.props;
const { title, image, date, location, tags } = photo.data;
const { Content } = await render(photo);

const formattedDate = date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout>
	<article class="container detail">
		<a class="back" href="/gallery/">← Back to gallery</a>
		<div class="image-wrap">
			<Image class="full" src={image} alt={title} width={1800} transition:name={`photo-${photo.id}`} />
		</div>
		<h1>{title}</h1>
		<p class="meta">
			{formattedDate}
			{location && ` · ${location}`}
		</p>
		{tags.length > 0 && <p class="tags">{tags.join(", ")}</p>}
		<div class="caption">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.detail {
		text-align: center;
		padding-bottom: var(--space-5);
	}

	.back {
		display: inline-block;
		margin-bottom: var(--space-4);
		font-size: 15px;
	}

	.back:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.image-wrap {
		margin-bottom: var(--space-3);
	}

	.full {
		width: 100%;
		max-width: 900px;
		height: auto;
		margin: 0 auto;
	}

	h1 {
		font-size: 32px;
		margin-bottom: 5px;
	}

	.meta {
		font-size: 15px;
		margin-bottom: 0;
	}

	.tags {
		font-size: 13px;
		margin: 5px 0 0;
	}

	.caption {
		max-width: 600px;
		margin: var(--space-3) auto 0;
		font-size: 16px;
	}

	.caption :global(p) {
		margin: 0;
	}
</style>
